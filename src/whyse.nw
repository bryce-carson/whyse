(whyse--)
@ 

<<create beframed buffers>>=
;; FIXME: it's not required that whyse use a frame or any dedicated
;; buffers. It's perfectly ergonomic to have a keybinding to open the
;; module index, like RefTeX's *toc* popup buffer (`reftex-toc').
(with-current-buffer (find-file (cl-second default-project))
  (make-frame ((name . "WHYSE"))))

